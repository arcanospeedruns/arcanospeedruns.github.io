---
layout: base.njk
pagination: { data: idiomas, size: 1, alias: idioma, addAllPagesToCollections: true }
permalink: "{{ '/en' if idioma == 'en' }}/"
caminho: "/"
titulo: "Carlos Gouveia"
ogTitulo: "Carlos Gouveia"
ogImagem: "/og.png"
preload: ["/fonts/satoshi-900.woff2", "/fonts/switzer-500.woff2"]
scripts: ["/site.js"]
meta:
  pt:
    descricao: "Carlos Gouveia, product designer em São Paulo. App Psiquê, Psiquê, Ruela Discos e twenty one pilots."
    ogDescricao: "Product designer em São Paulo. App Psiquê, Psiquê, Ruela Discos e twenty one pilots."
  en:
    descricao: "Carlos Gouveia, product designer in São Paulo. Psiquê app, Psiquê, Ruela Discos and twenty one pilots."
    ogDescricao: "Product designer in São Paulo. Psiquê app, Psiquê, Ruela Discos and twenty one pilots."
---
{#- uma imagem de prancha: --p é a proporção, usada pela fileira para igualar as alturas -#}
{%- macro foto(idioma, arq, w, h, pt, en, classe="", tam="(max-width: 600px) 100vw, 60vw") -%}
{%- set conjunto = arq | srcset(w) -%}
<img src="{{ arq }}"{% if conjunto %} srcset="{{ conjunto }}" sizes="{{ tam }}"{% endif %} width="{{ w }}" height="{{ h }}" alt="{{ en if idioma == 'en' else pt }}" loading="lazy" decoding="async" style="--p: {{ (w / h) | round(3) }}"{% if classe %} class="{{ classe }}"{% endif %}>
{%- endmacro -%}
{%- set R = "/projetos/ruela/" -%}
{%- set T = "/projetos/twenty-one-pilots/" -%}
{%- set P = "/projetos/psique/" -%}
{%- set A = "/projetos/psique-app/" -%}
{%- set email = "arcanospeedruns@gmail.com" -%}
{%- set cv = "/curriculo-en.pdf" if idioma == "en" else "/curriculo.pdf" -%}

<main class="abertura">
  <div class="coluna">
    <div class="coluna-topo">
      <a class="marca" href="{{ '/en/' if idioma == 'en' else '/' }}" aria-label="Carlos Gouveia">
        <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false"><rect width="200" height="200" fill="#ffd60a"/><path d="M48 140 C48 116 47 98 50 82 C53 62 56 44 59 31 Q61 22 68 28 C79 39 90 51 100 60 C106 64 114 64 120 62 C123 61 125 60 127 58 C134 48 141 38 146 30 Q151 22 154 31 C157 46 161 64 164 80 C167 98 166 118 166 140 C166 160 156 170 138 170 L76 170 C58 170 48 160 48 140 Z" transform="translate(104 0) scale(1.1 1) translate(-107 0)" fill="#000"/><g fill="#ffd60a"><ellipse cx="104" cy="112" rx="12" ry="17.5" transform="rotate(-5 104 112)"/><ellipse cx="143" cy="110" rx="8" ry="16" transform="rotate(-5 143 110)"/></g></svg>
      </a>
      <nav class="idioma" aria-label="{% tr %}Idioma<!--en-->Language{% endtr %}">
        {%- if idioma == "en" -%}
        <a href="{{ par }}" hreflang="pt-BR" lang="pt-BR">PT</a> / <span aria-current="true">EN</span>
        {%- else -%}
        <span aria-current="true">PT</span> / <a href="{{ par }}" hreflang="en" lang="en">EN</a>
        {%- endif -%}
      </nav>
    </div>

    <div class="apresentacao">
      <div>
        <h1 class="nome">CARLOS<br>GOUVEIA</h1>
        <p class="cargo">Product designer</p>
      </div>

      <nav aria-label="{% tr %}Projetos<!--en-->Projects{% endtr %}">
        <ul class="projetos">
          <li><a href="#psique-app" data-slide="0">{% tr %}App Psiquê<!--en-->Psiquê app{% endtr %}</a></li>
          <li><a href="#psique" data-slide="1">Psiquê</a></li>
          <li><a href="#ruela" data-slide="2">Ruela Discos</a></li>
          <li><a href="#twenty-one-pilots" data-slide="3">twenty one pilots</a></li>
        </ul>
      </nav>

      <ul class="contatos">
        <li><a href="mailto:{{ email }}">E-mail</a></li>
        <li><a href="https://www.linkedin.com/in/carloslnly">LinkedIn</a></li>
        <li><a href="https://github.com/arcanospeedruns">GitHub</a></li>
        <li><a href="{{ cv }}">{% tr %}Currículo<!--en-->Résumé{% endtr %}</a></li>
      </ul>
    </div>
  </div>

  <a class="moldura" href="#psique-app" aria-label="{% tr %}Abrir o projeto App Psiquê<!--en-->Open the Psiquê app project{% endtr %}" data-rotulos='{% tr %}["Abrir o projeto App Psiquê","Abrir o projeto Psiquê","Abrir o projeto Ruela Discos","Abrir o projeto twenty one pilots"]<!--en-->["Open the Psiquê app project","Open the Psiquê project","Open the Ruela Discos project","Open the twenty one pilots project"]{% endtr %}'>
    <div class="slide atual"><img src="{{ A }}abertura.webp" srcset="{{ A }}abertura-1200.webp 1200w, {{ A }}abertura.webp 2400w" sizes="(max-width: 860px) 100vw, 73vw" width="2400" height="1800" alt="" fetchpriority="high"></div>
    <div class="slide"><img src="{{ P }}mockup-placa.webp" srcset="{{ P }}mockup-placa-1200.webp 1200w, {{ P }}mockup-placa.webp 2160w" sizes="(max-width: 860px) 100vw, 73vw" width="2160" height="1620" alt="" loading="lazy"></div>
    <div class="slide" style="background: #0d0d0d"><img class="capa" src="{{ R }}capa-ultimo-onibus.webp" width="1400" height="1400" alt="" loading="lazy"></div>
    <div class="slide" style="background: #2e0f45"><img class="capa" src="{{ T }}capa.webp" width="1400" height="1400" alt="" loading="lazy"></div>
  </a>
</main>

{#- ================= APP PSIQUÊ ================= #}
<section class="projeto" id="psique-app" aria-labelledby="t-app">
  <div class="projeto-dentro">
    <p class="fechar"><span>{% tr %}App Psiquê<!--en-->Psiquê app{% endtr %}</span><a href="#">{% tr %}Fechar<!--en-->Close{% endtr %}</a></p>
    <div class="cabeca">
      <h2 class="nome" id="t-app" tabindex="-1">{% tr %}APP PSIQUÊ<!--en-->PSIQUÊ APP{% endtr %}</h2>
      <p>{% tr %}Conceito de app de agendamento para a clínica Psiquê. Quem procura terapia costuma chegar inseguro e desistir no caminho: o objetivo é marcar a primeira sessão em menos de um minuto.<!--en-->Concept for the Psiquê clinic's booking app. People looking for therapy often arrive unsure and give up along the way: the goal is to book a first session in under a minute.{% endtr %}</p>
    </div>
    <div class="sangria">
      {{ foto(idioma, A + "fluxo.webp", 2400, 592, "Fluxo em cinco passos: início, com quem, quando, confirmar e agendado", "Five-step flow: home, who, when, confirm and booked", tam="100vw") | safe }}
    </div>

    <h3 class="grupo">{% tr %}Uma dúvida por tela: com quem, quando e como.<!--en-->One question per screen: who, when and how.{% endtr %}</h3>
    <div class="sangria telas">
      <div class="fileira">
        {{ foto(idioma, A + "tela-1-inicio.webp", 780, 1688, "Tela inicial: ainda sem sessões e o botão Agendar sessão", "Home screen: no sessions yet and the Book a session button") | safe }}
        {{ foto(idioma, A + "tela-2-profissional.webp", 780, 1688, "Lista de profissionais com o próximo horário livre de cada uma e o atalho Não sei escolher", "List of therapists with each one's next free slot and a Help me choose shortcut") | safe }}
        {{ foto(idioma, A + "tela-3-horario.webp", 780, 1688, "Escolha do horário: dias da semana e horários livres, com os ocupados riscados", "Picking a time: weekdays and free slots, with taken ones crossed out") | safe }}
        {{ foto(idioma, A + "tela-4-confirmar.webp", 780, 1688, "Resumo antes de confirmar, com valor, regra de remarcação e pagamento", "Summary before confirming, with price, rescheduling rule and payment") | safe }}
        {{ foto(idioma, A + "tela-5-agendado.webp", 780, 1688, "Sessão agendada, com calendário, lembretes e como entrar na sala online", "Session booked, with calendar, reminders and how to join online") | safe }}
      </div>
    </div>

    <h3 class="grupo">{% tr %}A decisão que mais encurta o caminho: mostrar o próximo horário livre já na lista.<!--en-->The decision that shortens the path the most: showing the next free slot right in the list.{% endtr %}</h3>
    <div class="sangria">
      {{ foto(idioma, A + "decisao.webp", 2400, 1350, "Antes e depois: a lista sem horários pedia abrir cada agenda; a lista nova mostra o próximo horário livre de cada profissional", "Before and after: the list without times meant opening each calendar; the new list shows each therapist's next free slot", tam="100vw") | safe }}
    </div>

    <a class="proximo nome" href="#psique">{% tr %}Próximo: Psiquê<!--en-->Next: Psiquê{% endtr %}</a>
  </div>
</section>

{#- ================= PSIQUÊ ================= #}
<section class="projeto" id="psique" aria-labelledby="t-psique">
  <div class="projeto-dentro">
    <p class="fechar"><span>Psiquê</span><a href="#">{% tr %}Fechar<!--en-->Close{% endtr %}</a></p>
    <div class="cabeca">
      <h2 class="nome" id="t-psique" tabindex="-1">PSIQUÊ</h2>
      <p>{% tr %}Identidade visual para uma clínica de psicologia: releitura conceitual de um trabalho que fiz para uma cliente.<!--en-->Visual identity for a psychology clinic: a conceptual reworking of a project I made for a client.{% endtr %}</p>
    </div>
    <div class="sangria">
      {{ foto(idioma, P + "mockup-placa.webp", 2160, 1620, "Placa bandeira roxa da Psiquê na fachada, com a borboleta amarela e o nome", "Psiquê's purple blade sign on the building, with the yellow butterfly and the name", "alta", "100vw") | safe }}
    </div>

    <h3 class="grupo">{% tr %}Um folder explica a terapia antes da primeira consulta. No Instagram, cada post é um convite curto para conversar.<!--en-->A leaflet explains therapy before the first session. On Instagram, each post is a short invitation to talk.{% endtr %}</h3>
    <div class="sangria">
      <div class="fileira">
        {{ foto(idioma, P + "mockup-folder.webp", 2160, 1620, "Folder da Psiquê, aberto e fechado, visto de cima", "Psiquê leaflet, open and closed, seen from above") | safe }}
        {{ foto(idioma, P + "mockup-instagram.webp", 2160, 1620, "Perfil da Psiquê no Instagram, em um celular", "Psiquê's Instagram profile on a phone") | safe }}
      </div>
    </div>

    <h3 class="grupo">{% tr %}Manual de identidade<!--en-->Brand guidelines{% endtr %}</h3>
    <div class="sangria">
      <div class="fileira">
        {{ foto(idioma, P + "marca.webp", 2160, 1350, "Marca da Psiquê: a borboleta e o nome", "Psiquê brand: the butterfly and the name") | safe }}
        {{ foto(idioma, P + "miv-especificacoes.webp", 2160, 1350, "Página do manual com as especificações da marca", "Guidelines page with the brand specifications") | safe }}
      </div>
    </div>

    <a class="proximo nome" href="#ruela">{% tr %}Próximo: Ruela Discos<!--en-->Next: Ruela Discos{% endtr %}</a>
  </div>
</section>

{#- ================= RUELA DISCOS ================= #}
<section class="projeto" id="ruela" aria-labelledby="t-ruela">
  <div class="projeto-dentro">
    <p class="fechar"><span>Ruela Discos</span><a href="#">{% tr %}Fechar<!--en-->Close{% endtr %}</a></p>
    <div class="cabeca">
      <h2 class="nome" id="t-ruela" tabindex="-1">RUELA DISCOS</h2>
      <p>{% tr %}Identidade de um selo musical fictício de São Paulo: marca, capas, cartaz de festa e post de lançamento.<!--en-->Identity for a fictional São Paulo record label: logo, covers, party poster and release post.{% endtr %}</p>
    </div>
    <div class="sangria">
      {{ foto(idioma, R + "marca.webp", 2400, 1600, "Marca Ruela Discos: RUELA num retângulo preto sobre laranja", "Ruela Discos logo: RUELA in a black rectangle on orange", "alta", "100vw") | safe }}
    </div>

    <h3 class="grupo">{% tr %}Cada lançamento leva a etiqueta do selo e um número de catálogo.<!--en-->Every release carries the label's mark and a catalog number.{% endtr %}</h3>
    <div class="sangria">
      <div class="fileira">
        {{ foto(idioma, R + "capa-ultimo-onibus.webp", 1400, 1400, "Capa do EP Último ônibus, de Mira Lume, número 001", "Cover of the EP Último ônibus by Mira Lume, number 001") | safe }}
        {{ foto(idioma, R + "capa-sem-freio.webp", 1400, 1400, "Capa de Sem freio, de Bento Sol, número 002", "Cover of Sem freio by Bento Sol, number 002") | safe }}
        {{ foto(idioma, R + "capa-vao-livre.webp", 1400, 1400, "Capa de Vão livre, do Coletivo Vão, número 003", "Cover of Vão livre by Coletivo Vão, number 003") | safe }}
      </div>
    </div>

    <h3 class="grupo">{% tr %}A mesma tipografia condensada vai do cartaz da festa ao post de lançamento.<!--en-->The same condensed typeface runs from the party poster to the release post.{% endtr %}</h3>
    <div class="sangria">
      <div class="fileira">
        {{ foto(idioma, R + "cartaz.webp", 1400, 1980, "Cartaz da festa Ruela Noite 01", "Poster for the Ruela Noite 01 party") | safe }}
        {{ foto(idioma, R + "post.webp", 1400, 1750, "Post de lançamento de Vão livre", "Release post for Vão livre") | safe }}
      </div>
    </div>

    <a class="proximo nome" href="#twenty-one-pilots">{% tr %}Próximo: twenty one pilots<!--en-->Next: twenty one pilots{% endtr %}</a>
  </div>
</section>

{#- ================= TWENTY ONE PILOTS ================= #}
<section class="projeto" id="twenty-one-pilots" aria-labelledby="t-top">
  <div class="projeto-dentro">
    <p class="fechar"><span>twenty one pilots</span><a href="#">{% tr %}Fechar<!--en-->Close{% endtr %}</a></p>
    <div class="cabeca">
      <h2 class="nome" id="t-top" tabindex="-1">TWENTY ONE PILOTS</h2>
      <p>{% tr %}Redesign conceitual da identidade da banda para um disco fictício, Tailwind: marca, manual, papelaria, marketing e brindes. Projeto acadêmico não oficial, sem vínculo com a banda.<!--en-->Conceptual redesign of the band's identity for a fictional album, Tailwind: logo, guidelines, stationery, marketing and merch. Unofficial academic project, not affiliated with the band.{% endtr %}</p>
    </div>
    <div class="sangria">
      <div class="fileira">
        {{ foto(idioma, T + "capa.webp", 1400, 1400, "Capa de Tailwind: foto em preto e branco de um músico tocando baixo, sobre verde-lima, com o avião de papel atrás", "Tailwind cover: black and white photo of a musician playing bass on lime green, with the paper plane behind him") | safe }}
        {{ foto(idioma, T + "conceito.webp", 2400, 1500, "Conceito: o avião de papel feito de duas asas, ao lado do nome da banda", "Concept: the paper plane made of two wings, next to the band's name") | safe }}
      </div>
    </div>

    <h3 class="grupo">{% tr %}Um avião de papel de duas asas: sem motor, só voa com alguém dando impulso.<!--en-->A paper plane made of two wings: no engine, it flies only when someone gives it a push.{% endtr %}</h3>
    <div class="sangria">
      {{ foto(idioma, T + "logo.webp", 2400, 1500, "Logo horizontal, empilhado e só o símbolo", "Horizontal logo, stacked logo and symbol only", tam="100vw") | safe }}
    </div>

    <h3 class="grupo">{% tr %}Manual, papelaria, marketing e brindes seguem o mesmo sistema: o avião, quatro cores e duas fontes.<!--en-->Guidelines, stationery, marketing and merch follow one system: the plane, four colors and two typefaces.{% endtr %}</h3>
    <div class="sangria">
      <div class="fileira">
        {{ foto(idioma, T + "miv-versoes.webp", 2400, 1500, "Manual: versões da marca", "Guidelines: logo versions") | safe }}
        {{ foto(idioma, T + "miv-cores.webp", 2400, 1500, "Manual: paleta e códigos de cor", "Guidelines: palette and color codes") | safe }}
      </div>
      <div class="fileira">
        {{ foto(idioma, T + "miv-tipografia.webp", 2400, 1500, "Manual: tipografia", "Guidelines: typography") | safe }}
        {{ foto(idioma, T + "miv-grafismo.webp", 2400, 1500, "Manual: grafismos", "Guidelines: graphic patterns") | safe }}
      </div>
      <div class="fileira">
        {{ foto(idioma, T + "timbrado.webp", 1400, 1980, "Papel timbrado A4", "A4 letterhead") | safe }}
        {{ foto(idioma, T + "envelope-saco.webp", 1400, 1977, "Envelope saco", "Large envelope") | safe }}
        {{ foto(idioma, T + "sacola.webp", 1400, 1720, "Sacola", "Shopping bag") | safe }}
      </div>
      {{ foto(idioma, T + "cartao.webp", 2400, 774, "Cartão de visita, frente e verso", "Business card, front and back", tam="100vw") | safe }}
      <div class="fileira">
        {{ foto(idioma, T + "mkt-cartaz.webp", 1400, 1980, "Cartaz A3 de lançamento do disco", "A3 album release poster") | safe }}
        {{ foto(idioma, T + "mkt-banner.webp", 1200, 3000, "Banner roll-up da turnê", "Tour roll-up banner") | safe }}
        {{ foto(idioma, T + "mkt-cartaz-social.webp", 1400, 1980, "Cartaz de saúde mental Nobody flies alone, com o número 188 do CVV", "Mental health poster Nobody flies alone, with CVV's 188 helpline") | safe }}
      </div>
      {{ foto(idioma, T + "mkt-folder-dentro.webp", 2246, 1588, "Folder, lado de dentro", "Leaflet, inside", tam="100vw") | safe }}
      <div class="fileira">
        {{ foto(idioma, T + "brinde-camiseta-capa.webp", 1400, 2499, "Camiseta preta com a capa do disco", "Black T-shirt with the album cover") | safe }}
        {{ foto(idioma, T + "brinde-caneca.webp", 1400, 1619, "Caneca branca com o símbolo e o nome do disco", "White mug with the symbol and the album name") | safe }}
      </div>
    </div>

    <a class="proximo nome" href="#psique-app">{% tr %}Próximo: App Psiquê<!--en-->Next: Psiquê app{% endtr %}</a>
  </div>
</section>

