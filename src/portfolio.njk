---
layout: base.njk
pagination: { data: idiomas, size: 1, alias: idioma, addAllPagesToCollections: true }
permalink: "{{ '/en' if idioma == 'en' }}/portfolio.html"
caminho: "/portfolio.html"
ogImagem: "/og.png"
preload: ["/fonts/satoshi-900.woff2"]
corpo: "orbita"
topo: "normal"
pagina: "portfolio"
scripts: ["/onda.js"]
meta:
  pt:
    titulo: "Portfólio | arcanospeedruns"
    descricao: "Projetos de Carlos Gouveia."
    ogTitulo: "Portfólio | Carlos Gouveia"
    ogDescricao: "Projetos de produto, dados e design de Carlos Gouveia."
  en:
    titulo: "Portfolio | arcanospeedruns"
    descricao: "Projects by Carlos Gouveia."
    ogTitulo: "Portfolio | Carlos Gouveia"
    ogDescricao: "Product, data and design projects by Carlos Gouveia."
---
  <canvas id="onda" data-tela-cheia aria-hidden="true"></canvas>

  {% include "topo.njk" %}

  <main>
    <div class="cabecalho-dados">
      <h1>{% tr %}PORTFÓLIO<!--en-->PORTFOLIO{% endtr %}</h1>
      <p>{% tr %}Projetos de produto, dados e design. Cada cartão abre a página do projeto.<!--en-->Product, data and design projects. Each card opens the project page.{% endtr %}</p>
    </div>

    {#- textos dos projetos: src/_data/projetos.cjs #}
    {%- set lista = projetos[idioma] %}
    {%- set status = { andamento: "Em andamento", concluido: "Concluído", breve: "Em breve" } if idioma == "pt" else { andamento: "In progress", concluido: "Completed", breve: "Coming soon" } %}
    <ul class="cartoes" id="projetos" aria-label="{% tr %}Projetos<!--en-->Projects{% endtr %}">
    {%- for p in lista %}
      <li>
        <{% if p.pagina %}a href="{{ p.pagina }}"{% else %}div{% endif %} class="cartao" id="{{ p.id }}">
          {%- if p.capa %}
          <span class="capa"><img src="{{ p.capa }}" alt="" width="1200" height="600" loading="lazy"></span>
          {%- else %}
          <span class="capa fundo-{{ p.fundo or 'dados' }}" aria-hidden="true"><span class="sigla">{{ p.curto }}</span></span>
          {%- endif %}
          <span class="cartao-info">
            <span class="cartao-meta mono"><span>{{ p.area }}</span><span class="st-{{ p.status }}">{{ status[p.status] }}</span></span>
            <span class="cartao-nome">{{ p.nome }}</span>
            <span class="cartao-texto">{{ p.contexto }}</span>
            {%- if p.stack.length %}
            <span class="stack mono">{% for x in p.stack %}<span>{{ x }}</span>{% endfor %}</span>
            {%- endif %}
            {%- if p.pagina %}
            <span class="cartao-mais mono">{% tr %}VER O PROJETO<!--en-->SEE THE PROJECT{% endtr %}</span>
            {%- endif %}
          </span>
        </{% if p.pagina %}a{% else %}div{% endif %}>
      </li>
    {%- endfor %}
    </ul>
  </main>

  <p class="rodape mono"><span>SÃO PAULO, 2026</span></p>
