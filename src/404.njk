<script>
  // as páginas antigas do site viraram uma página só: quem chega por um link velho vai para o início
  (function () {
    var p = location.pathname;
    var en = p.indexOf("/en/") === 0;
    var antigas = /^\/(en\/)?(sobre|portfolio|contato|hub|empregos|dados|landing)\.html$|^\/(en\/)?projetos\//;
    if (antigas.test(p)) {
      var m = p.match(/projetos\/(psique|ruela|twenty-one-pilots)\.html$/);
      location.replace((en ? "/en/" : "/") + (m ? "#" + m[1] : ""));
    }
  })();
</script>
<main class="erro">
  <h1 class="nome">404</h1>
  <p>Esta página não existe ou mudou de endereço. <span lang="en">This page does not exist or has moved.</span></p>
  <p><a href="/">Voltar ao início</a> · <a href="/en/" lang="en">Back to home</a></p>
</main>
