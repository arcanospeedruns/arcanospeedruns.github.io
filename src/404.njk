    var p = location.pathname;
    if (/^\/(en\/)?(dados|landing)\.html$|^\/(en\/)?projetos\//.test(p)) {
      location.replace((p.indexOf("/en/") === 0 ? "/en/" : "/") + location.hash);
    }
  })();
</script>
