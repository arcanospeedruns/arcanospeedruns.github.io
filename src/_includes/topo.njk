{%- set t = site.textos[lang] -%}
<header class="topo{% if topo == 'landing' %} topo-landing{% endif %} mono">
      <div class="topo-esq"><a class="marca" href="{{ t.inicio }}" aria-label="{% if lang == 'en' %}Home{% else %}Início{% endif %}" title="{% if lang == 'en' %}Home{% else %}Início{% endif %}"><svg class="marca-gato" viewBox="36 18 136 154" aria-hidden="true" focusable="false"><mask id="olhos-gato"><rect x="0" y="0" width="200" height="200" fill="#fff"/><g fill="#000"><ellipse cx="104" cy="112" rx="12" ry="17.5" transform="rotate(-5 104 112)"/><ellipse cx="143" cy="110" rx="8" ry="16" transform="rotate(-5 143 110)"/></g></mask><g mask="url(#olhos-gato)"><path d="M48 140 C48 116 47 98 50 82 C53 62 56 44 59 31 Q61 22 68 28 C79 39 90 51 100 60 C106 64 114 64 120 62 C123 61 125 60 127 58 C134 48 141 38 146 30 Q151 22 154 31 C157 46 161 64 164 80 C167 98 166 118 166 140 C166 160 156 170 138 170 L76 170 C58 170 48 160 48 140 Z" transform="translate(104 0) scale(1.1 1) translate(-107 0)" fill="currentColor"/></g></svg></a>
        {%- if par -%}
        <span class="idioma" aria-label="{{ t.idioma }}">
          {%- if lang == "en" -%}
          <a href="{{ par }}" hreflang="pt-BR" lang="pt-BR">PT<span class="br">-BR</span></a><span aria-current="true">EN</span>
          {%- else -%}
          <span aria-current="true">PT<span class="br">-BR</span></span><a href="{{ par }}" hreflang="en" lang="en">EN</a>
          {%- endif -%}
        </span>
        {%- endif -%}
      </div>
{%- if topo != 'landing' %}
      <nav aria-label="{{ t.menu }}">
{%- for chave, item in t.nav %}
        <a href="{{ item[1] }}"{% if pagina == chave %} aria-current="page"{% endif %}>{{ item[0] }}</a>
{%- endfor %}
      </nav>
{%- endif %}
    </header>
